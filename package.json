    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.20.1",
    "postcss-html": "^1.8.1",
    "sass": "^1.77.0",
    "stylelint": "^16.3.1",
    "stylelint-config-standard-scss": "^13.0.0",
    "typescript": "^5.4.5",
    "vue": "^3.4.21"
